# ---------------------------------------------------------------------------
# Copie este arquivo para ".env" e preencha os valores.
# O arquivo .env está no .gitignore e NUNCA deve ser enviado ao GitHub.
# ---------------------------------------------------------------------------

# Chave secreta do Flask (gere uma com: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=troque-esta-chave

# --- E-mail (smtplib) -------------------------------------------------------
# Para Gmail, ative a verificação em duas etapas e crie uma "senha de app":
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email_remetente@gmail.com
SMTP_PASSWORD=sua_senha_de_app_aqui

# Destinatário padrão das notificações
NOTIFY_EMAIL=joaopedrochamhum@gmail.com

# true = não envia e-mails de verdade, apenas registra no log
EMAIL_DRY_RUN=false

# --- Verificação periódica --------------------------------------------------
SCHEDULER_ENABLED=true
CHECK_INTERVAL_MINUTES=10

# --- Padrões ----------------------------------------------------------------
DEFAULT_TIMEZONE=America/Sao_Paulo
DEFAULT_MIN_ELEVATION=10
DEFAULT_LEAD_MINUTES=15

# --- Servidor ---------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
FLASK_DEBUG=0
